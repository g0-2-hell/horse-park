generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum HorseGender {
  STALLION
  GELDING
  MARE
}

model Horse {
  id          Int          @id @default(autoincrement())
  name        String       @db.VarChar(255)
  gender      HorseGender
  breed       String?      @db.VarChar(255)
  coatColor   String       @map("coat_color") @db.VarChar(255)
  birthDate   DateTime?    @map("birth_date") @db.Date
  description String?
  horsePhotos HorsePhoto[]

  @@map("horses")
}

model HorsePhoto {
  id        Int      @id @default(autoincrement())
  horseId   Int      @map("horse_id")
  url       String   @db.VarChar(255)
  isMain    Boolean  @default(false) @map("is_main")
  createdAt DateTime @default(now()) @map("created_at")

  horse Horse @relation(fields: [horseId], references: [id], onDelete: Cascade)

  @@map("horse_photos")
}

model Service {
  id              Int            @id @default(autoincrement())
  title           String         @db.VarChar(255)
  price           Int?
  durationMinutes Int?           @map("duration_minutes")
  description     String?
  servicePhotos   ServicePhoto[]

  @@map("services")
}

model ServicePhoto {
  id        Int      @id @default(autoincrement())
  serviceId Int      @map("service_id")
  url       String   @db.VarChar(255)
  isMain    Boolean  @default(false) @map("is_main")
  createdAt DateTime @default(now()) @map("created_at")

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@map("services_photos")
}

model News {
  id          Int         @id @default(autoincrement())
  title       String      @db.VarChar(255)
  createdAt   DateTime    @default(now()) @map("created_at")
  isPublished Boolean     @default(false) @map("is_published")
  description String?
  newsPhotos  NewsPhoto[]

  @@map("news")
}

model NewsPhoto {
  id        Int      @id @default(autoincrement())
  newsId    Int      @map("news_id")
  url       String   @db.VarChar(255)
  isMain    Boolean  @default(false) @map("is_main")
  createdAt DateTime @default(now()) @map("created_at")

  news News @relation(fields: [newsId], references: [id], onDelete: Cascade)

  @@map("news_photos")
}
